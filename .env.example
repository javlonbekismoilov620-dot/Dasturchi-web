# ─────────────────────────────────────────────────────────────
# Dasturchi — muhit o‘zgaruvchilari namunasi
# Nusxa oling: cp .env.example .env.local  va qiymatlarni to‘ldiring.
# Hech qachon .env.local faylini git’ga qo‘shmang.
# ─────────────────────────────────────────────────────────────

# Saytning ommaviy manzili (sitemap, OAuth qaytish manzili uchun)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin huquqi beriladigan elektron pochtalar (vergul bilan).
# Shu pochta bilan ro‘yxatdan o‘tgan yoki kirgan foydalanuvchi avtomatik admin bo‘ladi.
ADMIN_EMAILS=siz@misol.uz

# ── Supabase (ixtiyoriy) ─────────────────────────────────────
# Uchala qiymat berilsa — PostgreSQL, Supabase Auth va Storage ishlatiladi.
# Berilmasa — lokal JSON ombori (.data/db.json) va lokal autentifikatsiya ishlaydi.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# MAXFIY: faqat serverda ishlatiladi, brauzerga hech qachon yuborilmaydi
SUPABASE_SERVICE_ROLE_KEY=

# Google orqali kirish (Supabase Dashboard → Authentication → Providers → Google yoqilgan bo‘lsa)
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# ── AI ustoz (ixtiyoriy) ─────────────────────────────────────
# Berilmasa, darslardagi “AI ustoz” bo‘limi “hali ulanmagan” deb ko‘rsatadi.
ANTHROPIC_API_KEY=
# Ixtiyoriy: model nomi (standart: claude-opus-5-5)
AI_MODEL=

# ── Qo‘shimcha ──────────────────────────────────────────────
# Lokal ma’lumotlar papkasi (standart: ./.data)
DATA_DIR=
# Python mashqlari uchun Pyodide manzili (standart: jsDelivr CDN)
NEXT_PUBLIC_PYODIDE_URL=
