# ─────────────────────────────────────────────────────────────
# Dasturchi — muhit o‘zgaruvchilari namunasi
# Nusxa oling: cp .env.example .env.local  va qiymatlarni to‘ldiring.
# Hech qachon .env.local faylini git’ga qo‘shmang.
# ─────────────────────────────────────────────────────────────

# Saytning ommaviy manzili (sitemap, OAuth qaytish manzili uchun)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin huquqi beriladigan elektron pochtalar (vergul bilan).
# Supabase rejimi: foydalanuvchi pochtasini TASDIQLAGANDAN keyin admin bo‘ladi
#   (loyihada "Confirm email" yoqilgan bo‘lishi shart; aks holda huquq berilmaydi).
# Lokal rejim: pochta tasdiqlanmaydi — admin hisobini birinchi bo‘lib o‘zingiz yarating.
# Bu ro‘yxatdagi admin’ni panel orqali pasaytirib bo‘lmaydi (avval shu yerdan olib tashlang).
ADMIN_EMAILS=siz@misol.uz

# ── Supabase (ixtiyoriy) ─────────────────────────────────────
# Uchala qiymat berilsa — PostgreSQL, Supabase Auth va Storage ishlatiladi.
# Berilmasa — lokal JSON ombori (.data/db.json) va lokal autentifikatsiya ishlaydi.
# Kalitlar: Supabase Dashboard → Project Settings → API Keys. Qo‘llanma: docs/supabase.md
NEXT_PUBLIC_SUPABASE_URL=https://<loyiha-ref>.supabase.co
# Ommaviy kalit (sb_publishable_…). Eski nom ham ishlaydi: NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# MAXFIY (sb_secret_…): faqat serverda ishlatiladi, brauzerga hech qachon yuborilmaydi.
# Eski nom ham ishlaydi: SUPABASE_SERVICE_ROLE_KEY (eyJ… JWT)
SUPABASE_SECRET_KEY=

# Bitta fayl uchun yuklash chegarasi, MB (standart: Supabase’da 50 — Free tarif chegarasi, lokal 200)
MEDIA_MAX_UPLOAD_MB=

# Google orqali kirish (Supabase Dashboard → Authentication → Providers → Google yoqilgan bo‘lsa)
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# ── AI ustoz (ixtiyoriy) ─────────────────────────────────────
# Berilmasa, darslardagi “AI ustoz” bo‘limi “hali ulanmagan” deb ko‘rsatadi.
ANTHROPIC_API_KEY=
# Ixtiyoriy: model nomi (standart: claude-opus-5-5)
AI_MODEL=

# ── Qo‘shimcha ──────────────────────────────────────────────
# Lokal ma’lumotlar papkasi (standart: ./.data)
DATA_DIR=
# Python mashqlari uchun Pyodide manzili (standart: jsDelivr CDN)
NEXT_PUBLIC_PYODIDE_URL=
